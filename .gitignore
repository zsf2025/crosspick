# Local project data (WorkBuddy memory/settings — not for version control)
.workbuddy/

# 项目文档：仅本地保留，不进版本库
docs/

# 导入/导出的数据文件：由脚本生成本地产物，不进版本库。
# 注意：用 data/* 而不是 data/，这样目录本身可以保留（放 .gitkeep），clone 后脚本不会因目录缺失报错。
data/*
!data/.gitkeep
